---
apiVersion: v1
kind: ServiceAccount
metadata:
  name: $name
  namespace: $namespace
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRole
metadata:
  name: $name
rules:
  # CRD management
  - apiGroups:
      - apiextensions.k8s.io
    resources:
      - customresourcedefinitions
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete
  # Odigos CRDs
  - apiGroups:
      - odigos.io
    resources:
      - "*"
    verbs:
      - "*"
  - apiGroups:
      - actions.odigos.io
    resources:
      - "*"
    verbs:
      - "*"
  # Core resources
  - apiGroups:
      - ""
    resources:
      - configmaps
      - secrets
      - services
      - serviceaccounts
      - pods
      - namespaces
      - resourcequotas
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete
  # Apps resources
  - apiGroups:
      - apps
    resources:
      - deployments
      - daemonsets
      - statefulsets
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete
  # RBAC resources
  - apiGroups:
      - rbac.authorization.k8s.io
    resources:
      - roles
      - rolebindings
      - clusterroles
      - clusterrolebindings
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete
  # Policy resources
  - apiGroups:
      - policy
    resources:
      - poddisruptionbudgets
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete
  # Webhook configurations
  - apiGroups:
      - admissionregistration.k8s.io
    resources:
      - mutatingwebhookconfigurations
      - validatingwebhookconfigurations
    verbs:
      - get
      - list
      - watch
      - create
      - update
      - patch
      - delete
---
apiVersion: rbac.authorization.k8s.io/v1
kind: ClusterRoleBinding
metadata:
  name: $name
roleRef:
  apiGroup: rbac.authorization.k8s.io
  kind: ClusterRole
  name: $name
subjects:
  - kind: ServiceAccount
    name: $name
    namespace: $namespace
---
apiVersion: apps/v1
kind: Deployment
metadata:
  name: $name
  namespace: $namespace
  labels:
    app: $name
spec:
  replicas: 1
  selector:
    matchLabels:
      app: $name
  template:
    metadata:
      labels:
        app: $name
    spec:
      serviceAccountName: $name
      containers:
        - name: installer
          image: $imageFull
          imagePullPolicy: Always
          env:
            - name: ODIGOS_NAMESPACE
              value: "$namespace"
            - name: ODIGOS_VERSION
              value: "1.8.4"
            - name: ODIGOS_AUTOSCALER_IMAGE
              value: "$autoscalerImageFull"
            - name: ODIGOS_COLLECTOR_IMAGE
              value: "$collectorImageFull"
            - name: ODIGOS_INIT_CONTAINER_IMAGE
              value: "$initContainerImageFull"
            - name: ODIGOS_SCHEDULER_IMAGE
              value: "$schedulerImageFull"
            - name: ODIGOS_INSTRUMENTOR_IMAGE
              value: "$instrumentorImageFull"
            - name: ODIGOS_ODIGLET_IMAGE
              value: "$odigletImageFull"
            - name: ODIGOS_UI_IMAGE
              value: "$uiImageFull"
            - name: ODIGOS_INSTALLER_NAME
              valueFrom:
                fieldRef:
                  fieldPath: metadata.name
            - name: ODIGOS_INSTALLER_NAMESPACE
              valueFrom:
                fieldRef:
                  fieldPath: metadata.namespace
          resources:
            requests:
              cpu: 100m
              memory: 128Mi
            limits:
              cpu: 500m
              memory: 512Mi

